#!/usr/bin/env python3
"""crew: run a fleet of coding-agent sessions as tabs in one cmux workspace.

One session is the director. It spawns workers, gives them work, watches their
state, and cleans up after them. Workers are ordinary interactive sessions in
ordinary terminal tabs, signed in as you, so they use your subscription rather
than an API key.

  crew install             put crew and crew-reap on your PATH
  crew doctor              check every configured agent can actually start
  crew spawn <role> <task> open a worker tab and wait until it is ready
  crew status              what every worker is doing
  crew wait                block until a worker goes idle or needs you
  crew approve <worker>    answer a worker's permission prompt
  crew show <worker>       read what a worker is showing, and asking
  crew say <worker> <text> deliver a message, safely
  crew merge <worker>      merge a worker's branch into this repo
  crew stop <worker>       close a worker's tab, keeping its work
  crew reap                remove finished worktrees (see crew-reap)

Nothing here runs in the background. Each command does one thing and exits.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get(
    "CREW_CONFIG", os.path.join(HOME, ".config", "crew", "crew.json"))
STATE_PATH = os.environ.get(
    "CREW_STATE", os.path.join(HOME, ".local", "state", "crew", "workers.json"))
# cmux writes one of these per agent. Overridable so tests can supply their own.
HOOKS_DIR = os.environ.get("CREW_HOOKS_DIR", os.path.join(HOME, ".cmuxterm"))
# One file per surface, written by the worker's own tab the moment its agent
# exits. The hook store cannot cover this: an agent that dies before its first
# hook fires never appears there at all.
EXIT_DIR = os.path.join(os.path.dirname(STATE_PATH), "exited")

REQUIRED_BINARIES = ("git", "cmux")

# How each agent is launched and how we know it started.
#
# Placeholders: {model} {effort} {worktree} {cwd} {name}. An argument
# containing a placeholder whose value is empty is dropped, so a role without
# an effort level simply omits the flag.
#
# ready:   the session is at its own prompt and can be given work.
# blocked: it is showing something a human must resolve. Never type at these.
#          A login screen especially: sending a key starts a browser sign-in
#          flow, and interrupting that can clear the stored credentials.
AGENTS = {
    "claude": {
        "bin": "claude",
        # Makes its own worktree, which is also the only way to avoid the
        # trust dialog: a directory Claude created is trusted automatically.
        "worktree": "self",
        "args": ["--worktree", "{worktree}", "--model", "{model}",
                 "--effort", "{effort}", "--name", "{name}"],
        # acceptEdits is the most autonomous mode a worker can be given
        # without a human in the loop. Measured, on this version:
        #   no flag             asks before every edit and every command
        #   --permission-mode auto   accepted, but the session comes up manual
        #   dontAsk             never asks and blocks edits too, so a worker
        #                       cannot do its own job
        #   bypassPermissions   allows everything, behind a warning dialog
        #                       that a human must answer once per session
        # So a worker edits freely and stops only at a command it may not run.
        # That stop is reported as needsInput, and `crew show` is how the
        # director reads the question and puts it to the human. To have fewer
        # of those, allow the commands you trust in your own agent settings
        # rather than loosening this.
        "permission": {
            "plan": ["--permission-mode", "plan"],
            "edit": ["--permission-mode", "acceptEdits"],
            "full": ["--permission-mode", "bypassPermissions"],
        },
        "ready": [r"shift\+tab to cycle", r"for shortcuts"],
        "blocked": [r"Yes, I trust this folder", r"Workspace trust not yet accepted",
                    r"Press any key to log in", r"/login", r"Invalid API key"],
        # A routine permission prompt, which the director answers on the
        # user's behalf when auto_approve is on. Distinct from blocked, which
        # is never answered automatically no matter what.
        "approval": {
            "prompt": [r"Do you want to proceed\?", r"requires approval"],
            "always": "2", "once": "1",
        },
        # The director is the only thing that should interrupt the user, so a
        # worker's own notifications are turned off. Verified that --settings
        # merges rather than replaces: the cmux hooks a worker needs still
        # register, so crew can still see it.
        "quiet_args": ["--settings",
                       '{"inputNeededNotifEnabled":false,'
                       '"agentPushNotifEnabled":false}'],
    },
    "codex": {
        "bin": "codex",
        # No worktree flag, so crew makes one.
        "worktree": "crew",
        # There is no flag that grants directory trust. Measured: an
        # interactive session in a directory codex has not seen shows its
        # trust prompt even when passed
        # -c projects."<dir>".trust_level="trusted". Trust is inherited from a
        # trusted parent, so trusting the repo once covers every worktree crew
        # makes under it. See "First run in a repo" in the README.
        #
        # --approve-for-me already implies the workspace-write sandbox, and
        # codex rejects both together.
        "args": ["-m", "{model}",
                 "-c", 'model_reasoning_effort="{effort}"'],
        "permission": {
            "plan": ["--sandbox", "read-only", "--ask-for-approval", "never"],
            "edit": ["--approve-for-me"],
            "full": ["--dangerously-bypass-approvals-and-sandbox"],
        },
        "ready": [r"for shortcuts", r"Run /review"],
        "blocked": [r"Do you trust the contents of this directory",
                    r"codex login", r"Not logged in"],
    },
    "cursor": {
        "bin": "cursor-agent",
        "worktree": "self",
        "args": ["--worktree", "{worktree}", "--model", "{model}", "--trust"],
        "permission": {
            "plan": ["--mode", "plan"],
            "edit": ["--auto-review"],
            "full": ["--force"],
        },
        # An API key in the environment silently overrides the signed-in
        # account, which moves the work onto usage billing instead of the
        # plan. Workers are meant to spend the subscription.
        "env_unset": ["CURSOR_API_KEY"],
        # Measured: this agent's hook records the session once and never
        # updates it, so it reads as running forever and wait would never
        # wake for it. Fall back to the screen, which is where its state is
        # actually visible.
        "lifecycle": "screen",
        "ready": [r"Plan, search, build anything", r"Add a follow-up"],
        "blocked": [r"Press any key to log in", r"Workspace Trust Required",
                    r"agent login"],
    },
}

# permission is a crew-level intent, mapped to each agent's own vocabulary:
#   plan  read and think, change nothing
#   edit  change files inside its own worktree without asking
#   full  no restrictions at all
DEFAULT_ROLES = {
    "planner":  {"agent": "claude", "model": "opus",   "effort": "max",
                 "permission": "plan"},
    "worker":   {"agent": "claude", "model": "sonnet", "effort": "medium",
                 "permission": "edit"},
    "reviewer": {"agent": "claude", "model": "opus",   "effort": "high",
                 "permission": "plan"},
}

DEFAULTS = {
    "agents": {},          # merged over AGENTS
    "roles": {},           # merged over DEFAULT_ROLES
    "ready_timeout": 90,   # seconds to wait for a worker to reach its prompt
    "max_workers": 4,      # 0 means no limit
    # A worker whose screen has not changed in this long, while it still
    # claims to be working, is stuck rather than thinking. Fractions are
    # allowed. 0 disables the check.
    "stall_minutes": 15,
    # For agents whose reported lifecycle is unreliable, how long a screen must
    # hold still before the worker counts as idle rather than working.
    "screen_idle_seconds": 20,
    # Answer workers' routine permission prompts instead of stopping to ask.
    # The point of a fleet is that it runs; a director that relays every
    # "may I run ls" is worse than no fleet at all. Anything in an agent's
    # blocked list is never answered this way: a login or a trust dialog is a
    # decision only the person can make, and answering one automatically
    # would be answering it wrongly.
    "auto_approve": True,
}

# Signs a session has run out of plan allowance. Deliberately broad, because
# every agent words this differently and the cost of missing it is a director
# that keeps spawning workers onto an exhausted account.
#
# These are heuristics. They have not been checked against a real exhaustion
# event for every agent, so treat a match as a strong hint and a non-match as
# no information. Extend per agent with an "exhausted" list in config.
QUOTA_PATTERNS = [
    r"usage limit", r"rate limit", r"quota", r"limit reached",
    r"out of (credits|tokens)", r"upgrade your plan",
    r"resets? (at|in) ", r"too many requests",
]

# A screen has to hold still across this many consecutive polls, and the
# session be at least this old, before an absence of change counts as ready.
# One identical pair is not enough: a slow welcome screen pauses mid-draw.
STABLE_READS = 2
SETTLE_FLOOR = 6


def log(msg=""):
    print(msg, flush=True)


def die(msg, code=2):
    log(msg)
    sys.exit(code)


def run(args, cwd=None, timeout=120, env=None):
    try:
        p = subprocess.run(args, cwd=cwd, timeout=timeout, env=env,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True)
    except subprocess.TimeoutExpired:
        return 124, ""
    except OSError as e:
        return 127, str(e)
    return p.returncode, p.stdout.strip()


def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
    os.replace(tmp, path)


def config():
    cfg = dict(DEFAULTS)
    cfg.update(load_json(CONFIG_PATH, {}))
    agents = {k: dict(v) for k, v in AGENTS.items()}
    for name, override in (cfg.get("agents") or {}).items():
        agents.setdefault(name, {}).update(override)
    cfg["agents"] = agents
    roles = {k: dict(v) for k, v in DEFAULT_ROLES.items()}
    for name, override in (cfg.get("roles") or {}).items():
        roles.setdefault(name, {}).update(override)
    cfg["roles"] = roles
    return cfg


# --- cmux -----------------------------------------------------------------

def cmux(*args, timeout=60):
    env = dict(os.environ, CMUX_QUIET="1")
    return run(["cmux", *args], timeout=timeout, env=env)


def caller_context():
    """The director's own workspace and pane, so workers land beside it."""
    rc, out = cmux("identify", "--json")
    if rc != 0:
        die("cmux is not answering. Is it running, and is this a cmux terminal?")
    try:
        caller = json.loads(out)["caller"]
    except (ValueError, KeyError):
        die("could not read the caller context from cmux identify")
    ws = os.environ.get("CMUX_WORKSPACE_ID")
    pane = uuid_for(caller["pane_ref"], "pane")
    if not ws or not pane:
        die("run crew from inside a cmux terminal tab")
    return ws, pane


def uuid_for(ref, kind):
    """Short refs resolve differently across cmux verbs, so always use UUIDs."""
    rc, out = cmux("tree", "--all", "--id-format", "both")
    if rc != 0:
        return None
    for line in out.splitlines():
        if f"{ref} " in line:
            m = re.search(r"[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}",
                          line)
            if m:
                return m.group(0)
    return None


def read_screen(ws, surface, lines=40):
    rc, out = cmux("read-screen", "--workspace", ws, "--surface", surface,
                   "--lines", str(lines))
    return out if rc == 0 else ""


# --- agents ---------------------------------------------------------------

# The PATH a pane command starts with: the pane's own shim directory, then
# almost nothing. Login files add the rest, but only some of it.
PANE_PATH = "/usr/bin:/bin:/usr/sbin:/sbin"


def resolve_launch(name):
    """How to invoke an agent from inside a worker's pane.

    Returns the bare name when a login shell in the pane will find it, and an
    absolute path only when it will not.

    Preferring the bare name is not laziness. cmux puts a per-pane wrapper
    early on each pane's PATH, and for some agents that wrapper is what
    installs the hooks reporting the session back to cmux. Resolving to an
    absolute path here would hand every worker the *director's* wrapper, which
    belongs to a different pane and disappears with it.
    """
    env = dict(os.environ, PATH=PANE_PATH)
    rc, out = run(["/bin/zsh", "-lc", f"command -v {name}"], timeout=30, env=env)
    if rc == 0 and out.strip():
        return name, "pane PATH"
    found = shutil.which(name)
    if not found:
        rc, out = run(["/bin/zsh", "-ilc", f"command -v {name}"], timeout=30)
        found = out.splitlines()[-1].strip() if rc == 0 and out.strip() else None
    if found and os.path.exists(found):
        return os.path.realpath(found), "absolute path"
    return None, "not found"


def build_argv(spec, binary, subs):
    argv = [binary]
    for arg in spec["args"]:
        filled = arg
        drop = False
        for key, val in subs.items():
            token = "{" + key + "}"
            if token in filled:
                if not val:
                    drop = True
                    break
                filled = filled.replace(token, str(val))
        if not drop:
            argv.append(filled)
    return prune_orphan_flags(argv, spec)


def prune_orphan_flags(argv, spec):
    """Drop a flag whose value was dropped for being empty."""
    out, i = [], 0
    placeholders = {a: b for a, b in zip(spec["args"], spec["args"][1:])}
    while i < len(argv):
        cur = argv[i]
        nxt = argv[i + 1] if i + 1 < len(argv) else None
        expects_value = cur.startswith("-") and placeholders.get(cur, "").count("{") == 1
        if expects_value and (nxt is None or nxt.startswith("-")):
            i += 1
            continue
        out.append(cur)
        i += 1
    return out


# --- worker state ---------------------------------------------------------

def workers():
    """The workers. Keys beginning with an underscore are crew's own notes,
    such as which workspace this director's fleet lives in, and are not
    workers."""
    return {k: v for k, v in load_json(STATE_PATH, {}).items()
            if not k.startswith("_")}


def put_worker(name, data):
    all_w = workers()
    all_w[name] = data
    save_json(STATE_PATH, all_w)


def drop_worker(name):
    all_w = workers()
    all_w.pop(name, None)
    save_json(STATE_PATH, all_w)


def hook_sessions():
    """Live agent sessions cmux knows about, keyed by surface id.

    cmux normalises this across every agent it integrates, which is what makes
    one status view possible without per-agent code.
    """
    out = {}
    hooks = HOOKS_DIR
    if not os.path.isdir(hooks):
        return out
    for fn in os.listdir(hooks):
        if not fn.endswith("-hook-sessions.json"):
            continue
        agent = fn.split("-hook-sessions.json")[0]
        data = load_json(os.path.join(hooks, fn), {})
        for s in (data.get("sessions") or {}).values():
            sid = s.get("surfaceId")
            if not sid:
                continue
            prev = out.get(sid)
            if prev and prev.get("updatedAt", 0) > s.get("updatedAt", 0):
                continue
            out[sid] = {"agent": agent, "state": s.get("agentLifecycle", "unknown"),
                        "pid": s.get("pid"), "cwd": s.get("cwd"),
                        "updatedAt": s.get("updatedAt", 0)}
    return out


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# --- commands -------------------------------------------------------------

def cmd_doctor(args, cfg):
    log(f"{'agent':10} {'launched as':40} {'found via':14} {'worktree':9} version")
    problems = 0
    for name, spec in sorted(cfg["agents"].items()):
        launch_as, how = resolve_launch(spec["bin"])
        if not launch_as:
            log(f"{name:10} {'(not found)':40} {'-':14} {spec['worktree']:9} missing")
            problems += 1
            continue
        probe = launch_as if os.path.isabs(launch_as) else shutil.which(spec["bin"])
        rc, ver = run([probe, "--version"], timeout=30) if probe else (1, "")
        ver = ver.splitlines()[0][:34] if rc == 0 and ver else "no --version"
        log(f"{name:10} {launch_as:40} {how:14} {spec['worktree']:9} {ver}")
    log("")
    for role, r in sorted(cfg["roles"].items()):
        agent = r.get("agent")
        mark = "ok" if agent in cfg["agents"] else "UNKNOWN AGENT"
        log(f"role {role:10} -> {agent} {r.get('model','')} {r.get('effort','')} {mark}")
        if mark != "ok":
            problems += 1
    log("")
    log("doctor checks that agents exist and report a version. It cannot tell "
        "whether they are signed in;\nthat only shows up at spawn, which fails "
        "loudly if a worker lands on a login screen.")
    return 1 if problems else 0


def cmd_spawn(args, cfg):
    role = cfg["roles"].get(args.role)
    if not role:
        die(f"unknown role {args.role}. Known: {', '.join(sorted(cfg['roles']))}")
    spec = cfg["agents"].get(role["agent"])
    if not spec:
        die(f"role {args.role} uses unknown agent {role['agent']}")

    sessions = hook_sessions()
    seen = refresh(workers(), sessions, cfg)
    exhausted = sorted({w["agent"] for _n, (st, w) in seen.items()
                        if st == "quota"})
    if role["agent"] in exhausted:
        die(f"{role['agent']} looks out of plan allowance: another worker is "
            f"showing a limit message. Spawning more spends nothing and hides "
            f"the problem. Check that worker, or use a role on a different "
            f"agent.", 1)

    limit = cfg["max_workers"]
    live = [w for _n, (st, w) in seen.items() if st != "gone"]
    if limit and len(live) >= limit:
        die(f"{len(live)} workers already running, limit is {limit}. "
            "Raise max_workers or reap one first.", 1)

    binary, _how = resolve_launch(spec["bin"])
    if not binary:
        die(f"{spec['bin']} is not on PATH and no login shell could find it")

    repo = os.path.realpath(args.cwd or os.getcwd())
    rc, top = run(["git", "-C", repo, "rev-parse", "--show-toplevel"])
    if rc != 0:
        die(f"{repo} is not a git repository")
    repo = os.path.realpath(top)

    name = args.name or f"{args.role}-{slug(args.task)[:24]}"
    if name in workers():
        die(f"a worker called {name} already exists")

    # Who owns the worktree decides where the agent starts.
    if spec["worktree"] == "crew":
        wt = os.path.join(repo, ".crew", "worktrees", name)
        if not os.path.exists(wt):
            rc, out = run(["git", "-C", repo, "worktree", "add", "-q", wt,
                           "-b", f"crew/{name}"])
            if rc != 0:
                die(f"could not create a worktree: {out}")
        cwd = wt
    else:
        cwd = repo  # the agent makes its own and moves itself there

    # Workers are tabs in the director's own pane, created with --focus false
    # so nothing moves. crew never changes focus or selection, in either
    # direction: it must not switch you to a worker, and it must not drag you
    # back either, because you may have deliberately gone to look at one.
    ws, pane = caller_context()
    surface = new_tab(ws, pane, cwd)
    title = f"{args.role} · {role['agent']} · {args.task[:40]}"
    cmux("rename-tab", "--workspace", ws, "--surface", surface, title)

    subs = {"model": role.get("model", ""), "effort": role.get("effort", ""),
            "worktree": name, "cwd": cwd, "name": name}
    argv = build_argv(spec, binary, subs)
    level = role.get("permission", "edit")
    modes = spec.get("permission") or {}
    if level not in modes:
        die(f"agent {role['agent']} has no '{level}' permission mode. "
            f"Known: {', '.join(sorted(modes)) or 'none'}")
    argv += modes[level]
    launch(ws, surface, cwd, argv, spec)

    put_worker(name, {"role": args.role, "agent": role["agent"], "task": args.task,
                      "surface": surface, "workspace": ws, "repo": repo,
                      "cwd": cwd, "argv": argv, "started": int(time.time())})

    state, detail = await_ready(ws, surface, spec, cfg["ready_timeout"])
    if state != "ready":
        log(f"worker {name} did not start: {detail}")
        log(f"  its tab is still open so you can see what happened: {title}")
        return 1

    where = worker_dir(name, workers().get(name, {}), hook_sessions())
    branch = worker_branch(where) if where and os.path.isdir(where) else None
    if branch:
        # Recorded now because merge must still work after the worktree is
        # removed, and reap removes it.
        rec = workers().get(name, {})
        rec["branch"] = branch
        put_worker(name, rec)
    log(f"worker {name} ready in {os.path.relpath(cwd, repo) or '.'}")
    if args.task and not args.no_task:
        ok, why = deliver(ws, surface, args.task, spec)
        log(f"  task delivered" if ok else f"  task NOT delivered: {why}")
        return 0 if ok else 1
    return 0


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-") or "task"


def pane_surfaces(ws, pane):
    rc, out = cmux("list-pane-surfaces", "--workspace", ws, "--pane", pane,
                   "--id-format", "both")
    if rc != 0:
        return []
    return re.findall(r"[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}",
                      out)


def new_tab(ws, pane, cwd):
    rc, out = cmux("new-surface", "--workspace", ws, "--pane", pane,
                   "--working-directory", cwd, "--focus", "false")
    if rc != 0:
        die(f"could not open a tab: {out}")
    m = re.search(r"surface:(\d+)", out)
    if not m:
        die(f"cmux did not return a surface: {out}")
    time.sleep(0.5)
    surface = uuid_for(f"surface:{m.group(1)}", "surface")
    if not surface:
        die("could not resolve the new tab to a stable id")
    return surface


def launch(ws, surface, cwd, argv, spec):
    """Start the agent, keeping the tab alive whatever happens.

    A pane whose command exits is closed by cmux, so a worker that dies on
    startup would vanish with its error message. The trailing shell keeps the
    evidence on screen.

    That shell is also a hazard: it echoes anything typed at it, so no amount
    of looking at the screen can tell a dead worker's prompt from a live
    agent's composer, and submitting there runs the message as a command. The
    tab records its own death in a file first, which is the only signal that
    cannot be faked by what happens to be on screen.
    """
    quoted = " ".join(shell_quote(a) for a in argv)
    unset = "".join(f"unset {v}; " for v in spec.get("env_unset", []))
    marker = exit_marker(surface)
    os.makedirs(EXIT_DIR, exist_ok=True)
    if os.path.exists(marker):
        os.remove(marker)
    inner = (f'export PATH="$PATH:{inherited_path()}"; {unset}'
             f"cd {shell_quote(cwd)} || exit 1; {quoted}; "
             f"crew_rc=$?; echo $crew_rc > {shell_quote(marker)}; "
             f"printf '\\n[crew] agent exited with status %s\\n' \"$crew_rc\"; "
             f"exec /bin/zsh -i")
    # Deliberately not a login shell. A login shell rebuilds PATH and the
    # pane's own wrapper loses to the real binary, which costs the worker its
    # cmux hooks and makes it invisible to `crew status`.
    rc, out = cmux("respawn-pane", "--workspace", ws, "--surface", surface,
                   "--command", f"exec /bin/zsh -c {shell_quote(inner)}")
    if rc != 0:
        die(f"could not start the agent: {out}")


def inherited_path():
    """The user's PATH, minus per-pane wrapper directories.

    A pane starts with its own wrapper directory first and little else. That
    wrapper must keep winning, so it is left in front and this is appended
    behind it. Another pane's wrapper directory would shadow it, so those are
    stripped: they belong to a different session and vanish with it.
    """
    parts = [p for p in os.environ.get("PATH", "").split(":")
             if p and "cmux-cli-shims" not in p]
    return ":".join(parts)


def shell_quote(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


def await_ready(ws, surface, spec, timeout):
    """Wait until the agent is at its prompt, or say why it will never be.

    Two signals, because neither is enough alone. The ready patterns are
    wording, and an agent's wording changes with its permission mode and
    between releases. A registered hook session proves the agent started but
    not that it has finished drawing, so on its own it would let a message be
    typed into a session still painting its welcome screen. A settled screen
    plus a registered session is both.
    """
    ready = [re.compile(p) for p in spec["ready"]]
    blocked = [re.compile(p) for p in spec["blocked"]]
    quota = [re.compile(p, re.I) for p in (spec.get("exhausted") or QUOTA_PATTERNS)]
    deadline = time.time() + timeout
    started = time.time()
    screen = ""
    previous = None
    stable = 0
    while time.time() < deadline:
        screen = read_screen(ws, surface, 40)
        for pat in quota:
            if pat.search(screen):
                return "quota", (
                    "it started but is reporting a plan limit "
                    f"(matched {pat.pattern!r}). Nothing was typed at it.")
        for pat in blocked:
            if pat.search(screen):
                return "blocked", (
                    f"it is showing something only you can answer "
                    f"({pat.pattern}). Nothing was typed at it.")
        if "[crew] agent exited with status" in screen:
            last = [l for l in screen.splitlines() if l.strip()][-3:]
            return "exited", "the agent exited: " + " | ".join(last)
        if any(p.search(screen) for p in ready):
            return "ready", ""
        # Nothing left to draw is the only readiness signal that holds across
        # agents. The patterns above are a fast path, but they are wording,
        # and wording changes with permission mode and between releases. A
        # hook session is no good either: some agents register one only once
        # they do something, so a session sitting at its prompt has none.
        #
        # Blocked, quota and exited screens are settled too, which is why they
        # are checked first and return before this.
        if screen.strip() and screen == previous:
            stable += 1
            if stable >= STABLE_READS and time.time() - started >= SETTLE_FLOOR:
                return "ready", ""
        else:
            stable = 0
        previous = screen
        time.sleep(2)
    tail = [l for l in screen.splitlines() if l.strip()][-2:]
    return "timeout", f"no prompt after {timeout}s. Last output: {' | '.join(tail)}"


def deliver(ws, surface, text, spec):
    """Type a message and submit it, only once it is known to have landed.

    cmux send types without submitting, so this is two calls. Between them we
    check the text actually reached the agent's composer. If the agent died
    the tab is a shell prompt, and submitting there would run the message as
    a command.
    """
    status = exited(surface)
    if status is not None:
        return False, (f"the agent exited with status {status}; its tab is a "
                       "shell prompt and the message would have been run as a "
                       "command")
    one_line = " ".join(text.split())
    rc, out = cmux("send", "--workspace", ws, "--surface", surface, one_line)
    if rc != 0:
        return False, f"cmux send failed: {out}"
    time.sleep(0.4)
    screen = read_screen(ws, surface, 40)
    probe = one_line[:24]
    if probe and probe not in " ".join(screen.split()):
        cmux("send-key", "--workspace", ws, "--surface", surface, "ctrl+u")
        return False, "the text did not appear in the agent's prompt, so it was " \
                      "not submitted. The session may have exited."
    if any(re.search(p, screen) for p in spec["blocked"]):
        cmux("send-key", "--workspace", ws, "--surface", surface, "ctrl+u")
        return False, "the session is showing a prompt only you can answer"
    rc, out = cmux("send-key", "--workspace", ws, "--surface", surface, "enter")
    return (rc == 0), (out if rc != 0 else "")


def cmd_status(args, cfg):
    sessions = hook_sessions()
    all_w = workers()
    if not all_w:
        log("no workers")
        return 0
    log(f"{'worker':28} {'role':10} {'agent':8} {'state':10} where")
    seen = refresh(all_w, sessions, cfg)
    # Answer routine requests here too. A director that polls status rather
    # than waiting would otherwise leave its whole fleet stopped on "may I
    # run this", which is the opposite of the point.
    if cfg.get("auto_approve", True):
        for name, (state, w) in list(seen.items()):
            if state != "needsInput":
                continue
            ok, _why = approve(w["workspace"], w["surface"],
                               cfg["agents"].get(w["agent"], {}))
            if ok:
                seen[name] = ("running", w)
    for name, (state, w) in sorted(seen.items()):
        actual = worker_dir(name, w, sessions)
        try:
            where = os.path.relpath(actual, w.get("repo", "")) or "."
        except ValueError:
            where = actual
        if where.startswith(".."):
            # Outside the repo, so a relative path is a wall of dots. Some
            # agents put their worktrees under the home directory.
            where = actual.replace(HOME, "~")
        log(f"{name:28} {w['role']:10} {w['agent']:8} {state:10} {where}")
    for label, note in (
        ("needsInput", "waiting on you"),
        ("stalled", "no visible progress, check or restart"),
        ("quota", "plan allowance looks exhausted"),
    ):
        names = [n for n, (st, _) in seen.items() if st == label]
        if names:
            log(f"\n{note}: {', '.join(sorted(names))}")
    return 0


def screen_fingerprint(text):
    """What the screen looks like, ignoring what changes on its own.

    Clocks, spinners and elapsed-time counters tick without any work
    happening, so they are stripped before comparing. Otherwise nothing would
    ever look stalled.
    """
    text = re.sub(r"\d+(\.\d+)?\s*(s|ms|m|h)\b", "", text)
    text = re.sub(r"\d{1,2}:\d{2}(:\d{2})?", "", text)
    text = re.sub(r"[·✻✳✽*|/\\-]+", "", text)
    # A stable digest, not hash(): Python randomises string hashing per
    # process, and every crew command is a new process, so hash() would make
    # an unchanged screen look different every single time.
    return hashlib.sha1(" ".join(text.split()).encode()).hexdigest()


def exit_marker(surface):
    return os.path.join(EXIT_DIR, f"{surface}.exit")


def exited(surface):
    """The status an agent exited with, or None if it is still running."""
    try:
        with open(exit_marker(surface)) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def worker_state(w, sessions):
    """One worker's state, from the terminal rather than from the worker.

    A worker that crashed or wedged cannot report that, so this never asks it.
    """
    # Checked before the hook store, which knows nothing about an agent that
    # died before its first hook fired.
    if exited(w["surface"]) is not None:
        return "gone", sessions.get(w["surface"], {})
    s = sessions.get(w["surface"], {})
    if not s:
        # No session recorded yet. Either it is still starting, or whatever
        # was there has gone without cmux noticing.
        age = time.time() - w.get("started", 0)
        return "starting" if age < 60 else "gone", s
    if not pid_alive(s.get("pid")):
        return "gone", s
    return s.get("state", "unknown"), s


def refresh(all_w, sessions, cfg):
    """Sample every worker once, and note stalls and exhausted plans.

    Each crew command is a separate process, so "has anything changed since
    last time" has to be written down rather than remembered.
    """
    now = time.time()
    stall_seconds = cfg["stall_minutes"] * 60
    out = {}
    for name, w in all_w.items():
        state, s = worker_state(w, sessions)
        spec = cfg["agents"].get(w["agent"], {})
        patterns = list(spec.get("exhausted") or QUOTA_PATTERNS)

        screen = ""
        if state not in ("gone",):
            screen = read_screen(w["workspace"], w["surface"], 40)

        # Only the tail. A worker whose work is about rate limits will write
        # the words "rate limit" and "quota" into its output, and a review of
        # this very file did exactly that and was reported as exhausted. An
        # agent that has actually run out says so last, where it stopped.
        tail = "\n".join(screen.splitlines()[-8:]) if screen else ""
        if tail and any(re.search(p, tail, re.I) for p in patterns):
            state = "quota"

        # A session can report needsInput and then finish the turn without
        # ever saying so, leaving a stale record that makes a director relay
        # a question nobody is asking. If nothing on screen is waiting for an
        # answer, it is not waiting.
        if state == "needsInput" and screen and (
                spec.get("approval") or spec.get("blocked")):
            # Only for agents whose asking looks like something crew can
            # recognise. Without a known prompt shape there is no way to tell
            # a finished turn from a real question, and guessing idle would
            # hide a worker that is genuinely waiting.
            asking = list((spec.get("approval") or {}).get("prompt") or [])
            asking += list(spec.get("blocked") or [])
            if not any(re.search(p, screen) for p in asking):
                state = "idle"

        if screen:
            fp = screen_fingerprint(screen)
            if fp != w.get("fp"):
                w["fp"] = fp
                w["fp_at"] = now
                put_worker(name, w)
            else:
                quiet = now - w.get("fp_at", now)
                if (spec.get("lifecycle") == "screen" and state == "running"
                        and quiet > cfg["screen_idle_seconds"]):
                    state = "idle"
                elif (state == "running" and stall_seconds
                      and quiet > stall_seconds):
                    state = "stalled"
        out[name] = (state, w)
    return out


def cmd_wait(args, cfg):
    """Block until a worker needs the director, then say which and why.

    This is what keeps a fleet moving without a background process: the
    director's loop is spawn, wait, handle, repeat. It returns as soon as
    anything has changed since the last call, so a worker that finished while
    the director was busy is reported immediately rather than waited on.
    """
    try:
        return wait_loop(args, cfg)
    except KeyboardInterrupt:
        log("stopped waiting. Nothing was missed: anything that changed while "
            "you were away is still unreported, so crew wait picks it up.")
        return 130


def wait_loop(args, cfg):
    interesting = {"idle", "needsInput", "gone", "stalled", "quota"}
    deadline = time.time() + args.timeout
    first = True
    while True:
        all_w = workers()
        if not all_w:
            log("no workers")
            return 0
        sessions = hook_sessions()
        changed = []
        for name, (state, w) in sorted(refresh(all_w, sessions, cfg).items()):
            if state == "needsInput" and cfg.get("auto_approve", True):
                # A worker waiting on "may I run this" is not news. Answer it
                # and let it get on with the work. Only what a person must
                # decide reaches the director.
                spec = cfg["agents"].get(w["agent"], {})
                ok, why = approve(w["workspace"], w["surface"], spec)
                if ok:
                    log(f"{name:28} approved its permission request")
                    continue
                if why == "no permission prompt is showing":
                    # The agent said it needs input a moment before drawing
                    # the prompt. Look again next time round rather than
                    # waking the director for something about to be handled.
                    continue
            if state != w.get("seen"):
                if state in interesting:
                    changed.append((name, state, w))
                else:
                    # Not news itself, but the state changed, so re-arm: the
                    # next return to an interesting state must be reported
                    # even if it matches what was last seen before this dip.
                    w["seen"] = state
                    put_worker(name, w)
        if changed:
            # Printed before it is marked seen. An interrupt between the two
            # can then only repeat a change, never swallow one, and repeating
            # is harmless where losing is not.
            for name, state, w in changed:
                log(f"{name:28} {state:10} {w['role']:10} {w['task'][:44]}")
            for name, state, w in changed:
                w["seen"] = state
                put_worker(name, w)
            return 0
        if not first and time.time() >= deadline:
            log(f"nothing changed in {args.timeout}s")
            return 0
        first = False
        if time.time() >= deadline:
            log(f"nothing changed in {args.timeout}s")
            return 0
        time.sleep(args.poll)


def cmd_install(args, cfg):
    """Put crew and crew-reap on PATH.

    Symlinks rather than copies, so pulling the repo updates the installed
    commands and there is never a stale second copy to be confused by.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    target = os.path.expanduser(args.prefix)
    tools = ["crew", "crew-reap"]

    if args.uninstall:
        for name in tools:
            link = os.path.join(target, name)
            if os.path.islink(link) and os.path.realpath(link).startswith(here):
                os.remove(link)
                log(f"removed {link}")
            elif os.path.exists(link):
                log(f"left {link} alone, it is not a link to this checkout")
        return 0

    if not os.path.isdir(target):
        die(f"{target} does not exist. Make it, or pass --prefix to a "
            "directory on your PATH.")
    for name in tools:
        source = os.path.join(here, name)
        link = os.path.join(target, name)
        if os.path.lexists(link):
            if os.path.realpath(link) == os.path.realpath(source):
                log(f"{link} already points here")
                continue
            if not args.force:
                die(f"{link} exists and is not this checkout. Pass --force to "
                    "replace it.")
            os.remove(link)
        os.symlink(source, link)
        log(f"linked {link} -> {source}")

    if args.quiet_cmux:
        log("")
        log(cmux_quiet_hint())

    on_path = target in os.environ.get("PATH", "").split(":")
    log("")
    if on_path:
        log("Both are on your PATH. A director session can now follow "
            "docs/DIRECTOR.md as written.")
    else:
        log(f"{target} is NOT on your PATH, so `crew` will not be found. "
            f"Add it:\n  export PATH=\"{target}:$PATH\"")
    return 0 if on_path else 1


def cmux_quiet_hint():
    """What to change in cmux so a fleet stays out of the way.

    Printed rather than written. crew does not edit a config it does not own,
    and a tool quietly reordering someone's terminal is exactly the behaviour
    being turned off here.
    """
    return (
        "To keep a fleet from disturbing you, in ~/.config/cmux/cmux.json:\n"
        "  \"app\": { \"reorderOnNotification\": false }\n"
        "then run: cmux reload-config\n"
        "That stops workspaces being reshuffled as workers come and go. crew "
        "already opens workers in a workspace of their own, so they never "
        "change the view you are working in.")


def worker_dir(name, w, sessions):
    """Where a worker is actually working.

    Ask git first. An agent that makes its own worktree puts it wherever it
    likes, and not every agent reports its own directory correctly: one of
    them records the cwd of its config directory instead, which would send
    merge and stop at entirely the wrong tree. Git knows the truth for any
    agent, because the worktree is named after the worker.
    """
    repo = w.get("repo") or ""
    if repo:
        rc, out = run(["git", "-C", repo, "worktree", "list", "--porcelain"])
        if rc == 0:
            for line in out.splitlines():
                if line.startswith("worktree "):
                    path = line.split(" ", 1)[1]
                    if os.path.basename(path) == name:
                        return path
    return sessions.get(w.get("surface"), {}).get("cwd") or w.get("cwd", "")


def worker_branch(path):
    rc, out = run(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"])
    return out if rc == 0 and out and out != "HEAD" else None


def cmd_stop(args, cfg):
    """Close a worker's tab and forget it. Its work stays on its branch.

    Stopping does not remove the worktree: `crew reap` does that, and it
    commits anything uncommitted first. Doing it here would mean deciding what
    to keep at the moment you are least able to look.
    """
    w = workers().get(args.worker)
    if not w:
        die(f"no worker called {args.worker}")
    sessions = hook_sessions()
    state, _ = worker_state(w, sessions)
    if state == "running" and not args.force:
        die(f"{args.worker} is mid-turn. Wait for it, or pass --force to stop "
            "it anyway. Anything it has written is kept either way.", 1)

    where = worker_dir(args.worker, w, sessions)
    pid = (sessions.get(w["surface"]) or {}).get("pid")
    cmux("close-surface", "--workspace", w["workspace"], "--surface", w["surface"])
    # Wait for it to actually go. Closing the tab signals the process; it does
    # not wait for it. Returning early means the very next reap sees the
    # worktree as still in use and skips it, and the merge after that finds an
    # empty branch, which is exactly the order this tool tells you to use.
    for _ in range(20):
        if not pid or not pid_alive(pid):
            break
        time.sleep(0.5)
    marker = exit_marker(w["surface"])
    if os.path.exists(marker):
        os.remove(marker)
    drop_worker(args.worker)

    branch = worker_branch(where) if where and os.path.isdir(where) else None
    log(f"stopped {args.worker}, it was {state}")
    if where and os.path.isdir(where):
        rc, holders = run(["lsof", "-a", "-d", "cwd", "-t", "--", where])
        if rc == 0 and holders.strip():
            # Closing the tab orphans the agent's helper processes, and the
            # cmux feed bridge parks for up to two minutes waiting for a
            # decision that is never coming. Reap will refuse while they hold
            # the directory, which is correct, so say so rather than let the
            # next command look broken.
            log(f"  {len(holders.split())} helper process(es) still hold its "
                "worktree; they exit within about two minutes. Reap will skip "
                "it until then, so run reap again if it does.")
    if branch:
        log(f"  its work is on {branch}")
        log(f"  crew reap --apply, then crew merge {branch}")
    log(f"  its worktree is still at {where}. crew reap removes it, "
        "committing anything uncommitted first.")
    return 0


def cmd_merge(args, cfg):
    """Merge a worker's branch into the repo you are in.

    Refuses rather than guesses. A merge that goes wrong mid-way is much
    harder to explain than one that never started.
    """
    repo = os.getcwd()
    w = workers().get(args.worker)
    if w:
        repo = w.get("repo") or repo
        sessions = hook_sessions()
        state, _ = worker_state(w, sessions)
        if state == "running" and not args.force:
            die(f"{args.worker} is still working. Merging now takes a "
                "half-written state. Wait for idle, or pass --force.", 1)

        # The branch, not the worktree, is what gets merged. A worker whose
        # worktree has already been reaped is still perfectly mergeable, and
        # reaping is exactly what the advice below tells you to do.
        where = worker_dir(args.worker, w, sessions)
        branch = w.get("branch")
        if where and os.path.isdir(where):
            branch = worker_branch(where) or branch
            rc, dirty = run(["git", "-C", where, "--no-optional-locks",
                             "status", "--porcelain"])
            if dirty:
                die(f"{args.worker} has {len(dirty.splitlines())} uncommitted "
                    "file(s), which are not on its branch yet. Commit them, or "
                    "run crew reap, which commits them for you. Merge works "
                    "either way, including after the worktree is gone.", 1)
        if not branch:
            die(f"{args.worker} has no branch recorded and no worktree left, "
                "so there is nothing to merge.", 1)
    else:
        # Not a live worker. Treat it as a branch, which is what `crew stop`
        # prints when it forgets one.
        branch = args.worker
        rc, _ = run(["git", "-C", repo, "rev-parse", "--verify",
                     f"refs/heads/{branch}"])
        if rc != 0:
            die(f"no worker or branch called {args.worker}")
    rc, _ = run(["git", "-C", repo, "rev-parse", "-q", "--verify", "MERGE_HEAD"])
    if rc == 0:
        die(f"a merge is already in progress in {repo}. Finish it, or run "
            f"git -C {repo} merge --abort. Until then nothing else can be "
            "merged.", 1)

    # Tracked changes only. Untracked files do not conflict with a merge, git
    # refuses on its own if one would be overwritten, and crew's own worktree
    # directory lives here untracked, which would otherwise make every repo
    # look permanently dirty.
    rc, dirty = run(["git", "-C", repo, "--no-optional-locks", "status",
                     "--porcelain", "--untracked-files=no"])
    if dirty:
        die(f"{repo} has uncommitted changes to {len(dirty.splitlines())} "
            "tracked file(s). Merging into a dirty checkout mixes your work "
            "with the worker's. Commit or stash first.", 1)

    into = worker_branch(repo) or "HEAD"
    rc, out = run(["git", "-C", repo, "merge", "--no-ff", branch, "-m",
                   f"Merge {branch}: {(w or {}).get('task', '')[:60]}"])
    if rc != 0:
        log(f"merge of {branch} into {into} did not complete:")
        log(out)
        log("")
        log("The merge is left in progress. Resolve it, or run "
            f"git -C {repo} merge --abort")
        return 1
    log(f"merged {branch} into {into}")
    log(f"  {out.splitlines()[-1] if out else ''}")
    if w:
        log(f"  {args.worker} is still open. crew stop closes it, crew reap "
            "removes its worktree.")
    return 0


def approve(ws, surface, spec, always=True):
    """Answer a worker's routine permission prompt.

    Returns (answered, why). Refuses on anything in the agent's blocked list:
    those are logins and trust dialogs, where a keystroke can start a browser
    sign-in flow or grant access the person never agreed to.
    """
    rules = spec.get("approval") or {}
    if not rules:
        return False, "this agent has no approval prompt defined"
    screen = read_screen(ws, surface, 40)
    if not screen.strip():
        return False, "nothing on screen"
    for pat in spec.get("blocked", []):
        if re.search(pat, screen):
            return False, ("it is showing something only a person can answer "
                           f"({pat}), so nothing was sent")
    if not any(re.search(p, screen) for p in rules.get("prompt", [])):
        return False, "no permission prompt is showing"

    # Typed as text then submitted, the same way a message is delivered.
    # One mechanism, already proven against both real agents and the tests.
    key = rules.get("always" if always else "once") or "1"
    cmux("send", "--workspace", ws, "--surface", surface, key)
    time.sleep(0.4)
    cmux("send-key", "--workspace", ws, "--surface", surface, "enter")
    time.sleep(1.5)
    after = read_screen(ws, surface, 40)
    if any(re.search(p, after) for p in rules.get("prompt", [])):
        return False, "the prompt is still showing after answering it"
    return True, ""


def cmd_approve(args, cfg):
    w = workers().get(args.worker)
    if not w:
        die(f"no worker called {args.worker}")
    spec = cfg["agents"].get(w["agent"], {})
    ok, why = approve(w["workspace"], w["surface"], spec, always=not args.once)
    if not ok:
        die(f"did not approve {args.worker}: {why}", 1)
    log(f"approved {args.worker}"
        + ("" if args.once else ", and told it not to ask again for that"))
    return 0


def cmd_show(args, cfg):
    """Print what a worker's tab is showing.

    A worker that needs a decision can only be helped if someone can read the
    question. status says a worker is waiting; this is how the director finds
    out what it is waiting for, so it can be put to the human in their words.
    """
    w = workers().get(args.worker)
    if not w:
        die(f"no worker called {args.worker}")
    state, _ = worker_state(w, hook_sessions())
    screen = read_screen(w["workspace"], w["surface"], args.lines)
    if not screen.strip():
        die(f"{args.worker} has no tab to read. It is {state}.", 1)
    log(f"{args.worker}  {state}  {w.get('task', '')}")
    log(f"{w['cwd']}")
    log("")
    log("\n".join(l for l in screen.splitlines() if l.strip()))
    return 0


def cmd_say(args, cfg):
    w = workers().get(args.worker)
    if not w:
        die(f"no worker called {args.worker}")
    spec = cfg["agents"][w["agent"]]
    sessions = hook_sessions()
    s = sessions.get(w["surface"], {})
    if s and not pid_alive(s.get("pid")):
        die(f"{args.worker} is not running. Its tab is still open.", 1)
    if s.get("state") == "running" and not args.now:
        die(f"{args.worker} is mid-turn. Wait for idle, or pass --now to interrupt.", 1)
    if args.now and s.get("state") == "running":
        cmux("send-key", "--workspace", w["workspace"], "--surface", w["surface"],
             "escape")
        time.sleep(1)
        # Escape immediately followed by text reads as one escape sequence and
        # swallows the first character. Clearing the line separates them and
        # removes anything the interrupted turn left in the composer.
        cmux("send-key", "--workspace", w["workspace"], "--surface", w["surface"],
             "ctrl+u")
        time.sleep(0.3)
    ok, why = deliver(w["workspace"], w["surface"], args.message, spec)
    if not ok:
        die(f"not delivered: {why}", 1)
    log(f"delivered to {args.worker}")
    return 0


def cmd_reap(args, cfg):
    reaper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "crew-reap")
    os.execv(reaper, [reaper, *args.rest])


def main():
    # reap forwards everything to crew-reap untouched. Handled before argparse
    # so its flags stay crew-reap's: argparse rejects a leading --apply as an
    # unknown option of crew's own, which made the documented cleanup command
    # in docs/DIRECTOR.md fail outright.
    if len(sys.argv) > 1 and sys.argv[1] == "reap":
        reaper = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              "crew-reap")
        os.execv(reaper, [reaper, *sys.argv[2:]])

    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    ins = sub.add_parser("install", help="put crew and crew-reap on PATH")
    ins.add_argument("--prefix", default="~/.local/bin")
    ins.add_argument("--uninstall", action="store_true")
    ins.add_argument("--force", action="store_true",
                     help="replace an existing file of the same name")
    ins.add_argument("--quiet-cmux", action="store_true",
                     help="print the cmux settings that keep a fleet out of "
                          "your way")

    sub.add_parser("doctor", help="check every agent can start")

    sp = sub.add_parser("spawn", help="open a worker tab and wait for it")
    sp.add_argument("role")
    sp.add_argument("task")
    sp.add_argument("--name")
    sp.add_argument("--cwd")
    sp.add_argument("--no-task", action="store_true",
                    help="start the worker but do not send the task")

    sub.add_parser("status", help="what every worker is doing")

    wt = sub.add_parser("wait", help="block until a worker needs you")
    wt.add_argument("--timeout", type=int, default=120)
    wt.add_argument("--poll", type=float, default=2.0)

    st = sub.add_parser("stop", help="close a worker's tab")
    st.add_argument("worker")
    st.add_argument("--force", action="store_true",
                    help="stop it even if it is mid-turn")

    mg = sub.add_parser("merge", help="merge a worker's branch into this repo")
    mg.add_argument("worker", help="a worker name, or a branch if it is gone")
    mg.add_argument("--force", action="store_true",
                    help="merge even if the worker is still working")

    ap_ = sub.add_parser("approve", help="answer a worker's permission prompt")
    ap_.add_argument("worker")
    ap_.add_argument("--once", action="store_true",
                     help="allow just this one, rather than not asking again")

    sh = sub.add_parser("show", help="read a worker's screen")
    sh.add_argument("worker")
    sh.add_argument("--lines", type=int, default=40)

    sy = sub.add_parser("say", help="deliver a message to a worker")
    sy.add_argument("worker")
    sy.add_argument("message")
    sy.add_argument("--now", action="store_true",
                    help="interrupt a running turn instead of refusing")

    rp = sub.add_parser("reap", help="remove finished worktrees")
    rp.add_argument("rest", nargs=argparse.REMAINDER)

    args = ap.parse_args()

    if args.cmd not in ("reap", "install"):
        missing = [b for b in REQUIRED_BINARIES if shutil.which(b) is None]
        if missing:
            die(f"crew needs {' and '.join(missing)} on PATH")

    cfg = config()
    return {
        "install": cmd_install, "doctor": cmd_doctor, "spawn": cmd_spawn,
        "status": cmd_status,
        "wait": cmd_wait, "say": cmd_say, "show": cmd_show, "stop": cmd_stop,
        "merge": cmd_merge, "approve": cmd_approve, "reap": cmd_reap,
    }[args.cmd](args, cfg)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
