#!/usr/bin/env python3
"""Reclaim disk from finished coding-agent git worktrees, without losing work.

Coding agents (Claude Code, Codex, Cursor) each create a git worktree per
session and none of them remove it afterwards. This finds those worktrees,
commits anything uncommitted so nothing is destroyed, and removes the
directory. The branch always survives.

Dry run unless you pass --apply.
"""

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get(
    "CREW_REAP_CONFIG", os.path.join(HOME, ".config", "crew", "reap.json"))

# Where projects usually live. Only those that exist are scanned, and only as
# a last resort: naming a repo skips this, and running from inside one scans
# that repo's parent directory (its siblings) instead.
COMMON_ROOTS = ["src", "code", "dev", "projects", "repos", "git", "github", "work"]

DEFAULTS = {
    # Empty means "guess", see resolve_roots().
    "roots": [],
    # Skip a worktree whose git metadata changed within this many minutes.
    "idle_minutes": 60,
    # Refuse to commit a single file larger than this, or a total larger than
    # max_total_mb. An immortal branch pins those objects past any future gc.
    "max_file_mb": 10,
    "max_total_mb": 50,
    # Never commit onto these. An agent worktree left sitting on a shared
    # branch would otherwise have its leftovers committed straight onto it.
    "protected_branches": ["main", "master", "develop", "trunk", "release"],
    # Gitignored paths worth keeping, keyed by absolute repo path. Prefer
    # declaring these per project in <repo>/.crew.json instead, which travels
    # with the project and works for everyone who checks it out.
    "rescue": {},
    # JSON files where a tool records its sessions. Any object holding both a
    # working directory and a pid counts as one, whatever the tool. This is
    # how a paused-but-resumable session keeps its worktree: the process is
    # gone, so nothing else would notice it. Add your own globs here.
    "session_registries": ["~/.cmuxterm/*-hook-sessions.json"],
}

# Keys a tool might use for a session's working directory and process id.
CWD_KEYS = ("cwd", "workingDirectory", "working_directory", "directory", "path")
PID_KEYS = ("pid", "processId", "process_id")

# git finds the worktrees; lsof tells us which are still in use. Neither is
# optional: without lsof every worktree looks idle.
REQUIRED_BINARIES = ("git", "lsof")

# Per-repo config, relative paths, e.g. {"rescue": ["art/generated"]}
REPO_CONFIG = ".crew.json"


def log(msg=""):
    print(msg, flush=True)


def run(args, cwd=None, check=False, timeout=120):
    try:
        p = subprocess.run(
            args, cwd=cwd, check=check, timeout=timeout,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
    except OSError as e:
        # cwd can go while we are working: another agent removing its own
        # worktree must fail this one plan, not abort every plan behind it.
        return 1, str(e)
    return p.returncode, p.stdout.strip()


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024.0


def dir_size(path):
    """Bytes actually reclaimed by deleting this tree.

    Hard links are counted once, the way du does. Build directories are full
    of them, and counting each link separately overstates the saving badly.
    """
    total = 0
    seen = set()
    for root, dirs, files in os.walk(path, onerror=lambda e: None):
        for f in files:
            fp = os.path.join(root, f)
            try:
                st = os.lstat(fp)
            except OSError:
                continue
            if os.path.islink(fp):
                continue
            if st.st_nlink > 1:
                key = (st.st_dev, st.st_ino)
                if key in seen:
                    continue
                seen.add(key)
            total += st.st_size
    return total


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH) as fh:
                cfg.update(json.load(fh))
        except (OSError, ValueError) as e:
            log(f"warning: ignoring unreadable {CONFIG_PATH}: {e}")
    cfg["roots"] = [os.path.expanduser(r) for r in cfg["roots"]]
    return cfg


def primary_checkout(path):
    """The primary checkout for a repo path, which may itself be a linked
    worktree.

    A linked worktree's own .crew.json and rescue destination must resolve
    to the primary checkout, the same one config keys the rescue list by,
    or a rescue configured for the primary is missed and any file it does
    rescue lands in the wrong place.
    """
    rc, common = run(["git", "rev-parse", "--git-common-dir"], cwd=path)
    primary = os.path.realpath(path)
    if rc == 0 and common:
        common = os.path.realpath(common if os.path.isabs(common)
                                   else os.path.join(path, common))
        if os.path.basename(common) == ".git":
            primary = os.path.dirname(common)
    return primary


def resolve_roots(cfg):
    """Where to look for repos when none was named."""
    if cfg["roots"]:
        return cfg["roots"]
    rc, out = run(["git", "rev-parse", "--show-toplevel"])
    if rc == 0 and out:
        # Run from inside a repo: that repo's neighbours are the obvious
        # scope.
        return [os.path.dirname(primary_checkout(out))]
    return [os.path.join(HOME, d) for d in COMMON_ROOTS
            if os.path.isdir(os.path.join(HOME, d))]


def rescue_paths(repo, cfg):
    """Gitignored paths worth keeping, from the repo's own config then global.

    Repo-local config is preferred: it travels with the project, so anyone
    running crew against it gets the same protection without configuring
    anything.
    """
    paths = []
    try:
        with open(os.path.join(repo, REPO_CONFIG)) as fh:
            paths += list(json.load(fh).get("rescue") or [])
    except (OSError, ValueError):
        pass
    paths += list(cfg.get("rescue", {}).get(os.path.realpath(repo)) or [])
    seen, out = set(), []
    for p in paths:
        if p in seen:
            continue
        seen.add(p)
        # .crew.json is checked in, so this list is whatever the repo's author
        # wrote, and every entry is joined onto both the worktree and the
        # primary, for a read and then a write. One that climbs out of the repo
        # copies files somewhere nobody asked for. Resolved rather than matched
        # on "..", so a longer way round does not get past it.
        if os.path.isabs(p) or not is_under(os.path.join(repo, p), repo):
            log(f"warning: ignoring rescue path outside the repo: {p!r}")
            continue
        out.append(p)
    return out


# --- liveness -------------------------------------------------------------
# A worktree is only reaped when nothing is using it.

def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError, TypeError, OverflowError):
        return False


def registry_cwds(patterns):
    """Working directories claimed by a live session in any tool's registry.

    Walks each JSON file looking for objects that carry both a working
    directory and a process id, rather than knowing any tool's schema. That
    keeps it working for tools this was never written against.
    """
    found = set()
    for pattern in patterns:
        for path in glob.glob(os.path.expanduser(pattern)):
            try:
                with open(path) as fh:
                    data = json.load(fh)
            # These files belong to other tools and are read as found. A deep
            # one exhausts json's recursion limit, which is not a ValueError.
            except (OSError, ValueError, RecursionError):
                continue
            stack = [data]
            while stack:
                node = stack.pop()
                if isinstance(node, dict):
                    cwd = next((node[k] for k in CWD_KEYS
                                if isinstance(node.get(k), str)), None)
                    pid = next((node[k] for k in PID_KEYS if k in node), None)
                    if cwd and pid is not None and pid_alive(pid):
                        found.add(os.path.realpath(cwd))
                    stack.extend(node.values())
                elif isinstance(node, list):
                    stack.extend(node)
    return found


def process_cwds():
    """Every live process's working directory, or None if that cannot be read.

    The general case: it needs no cooperation from whatever created the
    worktree, and catches tools that keep no registry at all. None means the
    check failed, which must stop the run. Returning an empty set would make
    every worktree look idle and reap live work.
    """
    found = set()
    try:
        rc, out = run(["lsof", "-d", "cwd", "-F", "n"], timeout=90)
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        if line.startswith("n/"):
            found.add(os.path.realpath(line[1:]))
    # This process is running from somewhere, so an empty result means lsof
    # did not do its job rather than that nothing is running.
    return found or None


def is_under(path, parent):
    path, parent = os.path.realpath(path), os.path.realpath(parent)
    return path == parent or path.startswith(parent + os.sep)


# --- discovery ------------------------------------------------------------

def find_repos(roots):
    repos = []
    for root in roots:
        if not os.path.isdir(root):
            continue
        for name in sorted(os.listdir(root)):
            path = os.path.join(root, name)
            if os.path.isdir(os.path.join(path, ".git")):
                repos.append(path)
    return repos


def list_worktrees(repo):
    """Every worktree git knows about, wherever it lives on disk.

    Agents scatter these across .claude/worktrees, .git/codex-worktrees,
    ~/.cursor/worktrees and ~/.codex/worktrees, but git records all of them,
    so one command finds the lot.
    """
    # -z ends each field with a NUL instead of a newline. Without it a
    # worktree path containing a newline splits its own record in two, and the
    # truncated head of the path reads as a directory that is not there.
    rc, out = run(["git", "worktree", "list", "--porcelain", "-z"], cwd=repo)
    fields = out.split("\0")
    if rc != 0:
        # git before 2.36 has no -z.
        rc, out = run(["git", "worktree", "list", "--porcelain"], cwd=repo)
        fields = out.splitlines()
    if rc != 0:
        return []
    trees, cur = [], {}
    for line in fields:
        if not line.strip():
            if cur:
                trees.append(cur)
            cur = {}
            continue
        key, _, val = line.partition(" ")
        if key == "worktree":
            cur = {"path": val, "locked": False, "lock_reason": "",
                   "detached": False, "branch": None, "prunable": False}
        elif key == "HEAD":
            cur["head"] = val
        elif key == "branch":
            cur["branch"] = val.replace("refs/heads/", "")
        elif key == "detached":
            cur["detached"] = True
        elif key == "locked":
            cur["locked"] = True
            cur["lock_reason"] = val
        elif key == "prunable":
            cur["prunable"] = True
    if cur:
        trees.append(cur)
    if trees:
        # git lists the main worktree first. Believe that rather than the path
        # we were pointed at: pointed at a linked worktree, the real primary
        # checkout would otherwise look like a candidate for removal.
        trees[0]["primary"] = True
    return trees


def gitdir_mtime(repo, wt_path):
    """Newest mtime of the worktree's git metadata.

    A cheap proxy for recent activity. Walking a 6GB tree is not.
    """
    rc, out = run(["git", "rev-parse", "--git-dir"], cwd=wt_path)
    if rc != 0:
        return 0
    gd = out if os.path.isabs(out) else os.path.join(wt_path, out)
    newest = 0
    for f in ("index", "HEAD", "ORIG_HEAD"):
        fp = os.path.join(gd, f)
        try:
            newest = max(newest, os.stat(fp).st_mtime)
        except OSError:
            pass
    return newest


# --- reaping --------------------------------------------------------------

def dirty_files(wt):
    """Paths git would stage: modified and untracked, never ignored."""
    # --no-optional-locks keeps git from rewriting the index just to look at
    # it. Without it, scanning makes every worktree appear freshly active and
    # the next run skips them all.
    # -z gives NUL-terminated, never-quoted paths. The default --porcelain
    # format C-quotes anything with a Unicode or unusual byte in it, so
    # paths like that were coming back as their literal escaped form
    # ("\346\226\207.txt") instead of the real filename.
    rc, out = run(["git", "--no-optional-locks", "status", "--porcelain",
                   "--untracked-files=all", "-z"], cwd=wt)
    if rc != 0:
        return None
    tokens = out.split("\0")
    paths = []
    i = 0
    while i < len(tokens):
        entry = tokens[i]
        i += 1
        if not entry:
            continue
        status, p = entry[:2], entry[3:]
        if status[0] in "RC":
            # Rename/copy: this record's path is followed by the old path
            # as a separate NUL-terminated field.
            i += 1
        paths.append(p)
    return paths


def rescue_missing(wt_path, repo, rel):
    """Files under `rel` that exist in the worktree but not the primary.

    Compared file by file, not directory by directory. The primary usually
    has a copy of these paths already, and the handful of files the worktree
    added are exactly the ones worth keeping.
    """
    src_root = os.path.join(wt_path, rel)
    dst_root = os.path.join(repo, rel)
    if not os.path.exists(src_root):
        return [], 0
    if os.path.isfile(src_root):
        if os.path.exists(dst_root):
            return [], 0
        return [""], os.path.getsize(src_root)

    missing, nbytes = [], 0
    for root, dirs, files in os.walk(src_root, onerror=lambda e: None):
        for f in files:
            sp = os.path.join(root, f)
            if os.path.islink(sp):
                continue
            sub = os.path.relpath(sp, src_root)
            if not os.path.exists(os.path.join(dst_root, sub)):
                try:
                    nbytes += os.path.getsize(sp)
                except OSError:
                    continue
                missing.append(sub)
    return missing, nbytes


def plan_worktree(repo, wt, cfg, live, siblings=()):
    """Decide what to do with one worktree. No side effects."""
    path = wt["path"]
    d = {"repo": repo, "path": path, "branch": wt.get("branch"),
         "detached": wt.get("detached"), "locked": wt.get("locked"),
         "action": None, "reason": "", "size": 0, "dirty": [], "rescue": []}

    if not os.path.isdir(path):
        # The record is the only gc root left for a detached HEAD, so pruning
        # it is what makes those commits collectable. Carry the sha across.
        d["action"] = "prune"
        d["reason"] = "directory is gone, git record is stale"
        d["head"] = wt.get("head")
        return d

    if wt.get("primary") or os.path.realpath(path) == os.path.realpath(repo):
        d["action"] = "skip"
        d["reason"] = "primary checkout"
        return d

    for cwd in live:
        if is_under(cwd, path):
            d["action"] = "skip"
            d["reason"] = "in use by a running process"
            return d

    for other in siblings:
        # Agent worktrees live in a gitignored directory, so one nested
        # inside another never shows up in git status. `git worktree remove`
        # deletes the whole tree and takes the inner worktree's uncommitted
        # work with it.
        if other != path and is_under(other, path):
            d["action"] = "skip"
            d["reason"] = f"holds another worktree, {other}"
            return d

    if wt["locked"]:
        # A lock naming a live process is an agent still using it. A lock
        # naming a dead one is that agent's leftovers, safe to clear. Any
        # other lock was put there by a person, and removing a worktree
        # someone deliberately locked is the opposite of what they asked for.
        pid = None
        if "pid " in wt["lock_reason"]:
            try:
                pid = wt["lock_reason"].split("pid ", 1)[1].split()[0]
            except IndexError:
                pid = None
        if pid and pid_alive(pid):
            d["action"] = "skip"
            d["reason"] = f"locked by live pid {pid}"
            return d
        if not pid:
            d["action"] = "skip"
            d["reason"] = ("locked by hand"
                           + (f": {wt['lock_reason']}" if wt["lock_reason"] else "")
                           + ". Unlock it yourself if you want it removed.")
            return d

    age_min = (time.time() - gitdir_mtime(repo, path)) / 60.0
    if age_min < cfg["idle_minutes"]:
        d["action"] = "skip"
        d["reason"] = f"active {age_min:.0f}m ago, under the {cfg['idle_minutes']}m idle window"
        return d

    d["size"] = dir_size(path)

    for rel in rescue_paths(repo, cfg):
        missing, nbytes = rescue_missing(path, repo, rel)
        if missing:
            d["rescue"].append((rel, len(missing), nbytes))

    files = dirty_files(path)
    if files is None:
        d["action"] = "skip"
        d["reason"] = "git status failed"
        return d
    d["dirty"] = files

    d["protected"] = wt.get("branch") in cfg["protected_branches"]

    if files:
        for rel in files:
            if os.path.exists(os.path.join(path, rel, ".git")):
                d["action"] = "skip"
                d["reason"] = (f"{rel} is a nested git repo. `git add -A` would "
                                "stage it as a gitlink, not its files. Remove or "
                                "commit it by hand first.")
                return d
        total = 0
        for rel in files:
            try:
                sz = os.path.getsize(os.path.join(path, rel))
            except OSError:
                continue
            if sz > cfg["max_file_mb"] * 1024 * 1024:
                d["action"] = "skip"
                d["reason"] = f"{rel} is {human(sz)}, over the {cfg['max_file_mb']}MB per-file limit"
                return d
            total += sz
        if total > cfg["max_total_mb"] * 1024 * 1024:
            d["action"] = "skip"
            d["reason"] = f"{human(total)} uncommitted, over the {cfg['max_total_mb']}MB limit"
            return d
        d["action"] = "commit+remove"
    else:
        d["action"] = "remove"
    return d


def rescue_branch(path):
    """Where a worktree's otherwise-homeless commits go.

    Named after the directory, but a directory name is not a ref name: a
    space, a colon or a trailing .lock all make git refuse the branch, and a
    worktree whose rescue branch cannot be created is one that can never be
    reaped. Two directories can map to the same name, which the caller
    already handles by refusing to move an existing branch.
    """
    name = "".join(c if c.isalnum() or c in "-_" else "-"
                   for c in os.path.basename(path))
    return "crew-rescued/" + (name.lstrip("-") or "worktree")


def save_detached(repo, path, sha):
    """Anchor a detached worktree's commits to a branch before it goes away."""
    name = rescue_branch(path)
    rc, out = run(["git", "branch", name, sha], cwd=repo)
    if rc == 0:
        return True, ""
    if "already exists" not in out:
        return False, f"could not save detached commits to a branch: {out}"
    rc, existing_sha = run(["git", "rev-parse", name], cwd=repo)
    if rc != 0 or existing_sha != sha:
        return False, (f"rescue branch {name} already exists and points "
                       f"elsewhere, worktree left in place: {out}")
    return True, ""


def apply_plan(d):
    """Execute one plan. Every step is safe to re-run after a crash."""
    path, repo = d["path"], d["repo"]

    if d["action"] == "prune":
        if d.get("detached") and d.get("head"):
            ok, msg = save_detached(repo, path, d["head"])
            if not ok:
                return False, msg
        run(["git", "worktree", "prune"], cwd=repo)
        return True, "pruned stale record"

    for rel, _, _ in d["rescue"]:
        missing, _ = rescue_missing(path, repo, rel)
        for sub in missing:
            src = os.path.join(path, rel, sub) if sub else os.path.join(path, rel)
            dst = os.path.join(repo, rel, sub) if sub else os.path.join(repo, rel)
            try:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(src, dst)
            except (OSError, shutil.Error) as e:
                return False, f"rescue of {rel}/{sub} failed, nothing removed: {e}"

    if d["action"] == "commit+remove":
        # Leftovers never land on a shared branch. Move to a rescue branch
        # first, so main stays exactly where it was.
        if d.get("protected"):
            name = rescue_branch(path)
            rc, out = run(["git", "switch", "-c", name], cwd=path)
            if rc != 0:
                return False, f"could not move off {d['branch']}: {out}"
            d["branch"] = name
        rc, out = run(["git", "add", "-A"], cwd=path)
        if rc != 0:
            return False, f"git add failed: {out}"
        msg = f"crew reap: {len(d['dirty'])} uncommitted file(s) from an abandoned agent worktree"
        rc, out = run([
            "git", "-c", "user.name=crew", "-c", "user.email=crew@local",
            "commit", "--no-verify", "-m", msg,
        ], cwd=path)
        if rc != 0:
            return False, f"commit failed: {out}"

    # A detached HEAD is unreachable the moment its worktree goes, whether or
    # not there was anything uncommitted. A clean detached worktree took the
    # straight removal path and lost its commits.
    if d.get("detached"):
        rc, sha = run(["git", "rev-parse", "HEAD"], cwd=path)
        if rc == 0 and sha:
            ok, msg = save_detached(repo, path, sha)
            if not ok:
                return False, msg

    if d["locked"]:
        # Only ever an agent's own stale lock: a lock set by a person is
        # skipped before we get here.
        run(["git", "worktree", "unlock", path], cwd=repo)

    rc, out = run(["git", "worktree", "remove", path], cwd=repo)
    if rc != 0:
        return False, f"remove refused, worktree left in place: {out}"

    run(["git", "worktree", "prune"], cwd=repo)
    return True, "removed"


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true",
                    help="actually do it (default is a dry run)")
    ap.add_argument("--repo", action="append",
                    help="limit to this repo, repeatable")
    ap.add_argument("--idle-minutes", type=int,
                    help="override the idle window")
    ap.add_argument("--quiet", action="store_true",
                    help="only print worktrees that will be acted on")
    args = ap.parse_args()

    missing = [b for b in REQUIRED_BINARIES if shutil.which(b) is None]
    if missing:
        log(f"crew-reap needs {' and '.join(missing)} on PATH. "
            "Refusing to run: without them it cannot tell a busy worktree "
            "from an abandoned one.")
        return 2

    cfg = load_config()
    if args.idle_minutes is not None:
        cfg["idle_minutes"] = args.idle_minutes

    bad_repos = []
    if args.repo:
        repos, seen = [], set()
        for r in args.repo:
            expanded = os.path.expanduser(r)
            if not os.path.isdir(expanded):
                bad_repos.append(r)
                log(f"warning: --repo {r} does not exist, skipping")
                continue
            primary = primary_checkout(expanded)
            if primary not in seen:
                seen.add(primary)
                repos.append(primary)
    else:
        repos = find_repos(resolve_roots(cfg))
    if not repos:
        log("no git repos found. Pass --repo <path>, or set roots in "
            + CONFIG_PATH)
        return 2 if bad_repos else 0

    running = process_cwds()
    if running is None:
        log("could not read running processes from lsof. Refusing to run: "
            "every worktree would look idle and live work could be removed.")
        return 2
    live = running | registry_cwds(cfg["session_registries"])
    plans = []
    for repo in repos:
        trees = list_worktrees(repo)
        paths = [w["path"] for w in trees]
        for wt in trees:
            d = plan_worktree(repo, wt, cfg, live, paths)
            if d["action"] != "skip" or not args.quiet:
                plans.append(d)

    actionable = [d for d in plans if d["action"] not in ("skip", None)]
    if not actionable:
        log("nothing to reap")
        if not args.quiet:
            for d in plans:
                log(f"  skip  {d['path']}\n        {d['reason']}")
        return 2 if bad_repos else 0

    log("dry run, nothing has changed. Pass --apply to execute.\n" if not args.apply else "")
    reclaimable = 0
    for d in actionable:
        reclaimable += d["size"]
        log(f"{d['action']:14} {d['path']}")
        log(f"{'':14} {human(d['size'])}, branch {d['branch'] or '(detached)'}"
            + (f", {len(d['dirty'])} uncommitted file(s)" if d["dirty"] else ""))
        if d.get("protected"):
            log(f"{'':14} {d['branch']} is protected, leftovers go to "
                f"{rescue_branch(d['path'])} instead")
        for rel, count, sz in d["rescue"]:
            log(f"{'':14} rescue {count} file(s) ({human(sz)}) under {rel}, "
                f"absent from the primary checkout")

    skipped = [d for d in plans if d["action"] == "skip"]
    if skipped and not args.quiet:
        log("")
        for d in skipped:
            log(f"{'skip':14} {d['path']}\n{'':14} {d['reason']}")

    log(f"\n{len(actionable)} worktree(s), {human(reclaimable)} reclaimable")

    if not args.apply:
        return 2 if bad_repos else 0

    log("")
    failures = 0
    freed = 0
    for d in actionable:
        ok, msg = apply_plan(d)
        if ok:
            freed += d["size"]
            log(f"ok      {d['path']}: {msg}")
        else:
            failures += 1
            log(f"FAILED  {d['path']}: {msg}")
    log(f"\nfreed {human(freed)}, {failures} failure(s)")
    return 1 if failures or bad_repos else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
